    },
    {
      "label": "Run Comparative Benchmarks",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python main.py benchmark",
      "problemMatcher": []
    },
    {
      "label": "Run Test Suite",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python main.py test",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
